# Offline default. Never commit .env or credentials.
WORKFLOW_PROVIDER=mock
WORKFLOW_MODEL=mock-fixture-v1
# Required only with WORKFLOW_PROVIDER=openai; include /v1 if your provider needs it.
WORKFLOW_BASE_URL=
WORKFLOW_API_KEY=
WORKFLOW_RESPONSE_MODE=json_schema
WORKFLOW_TIMEOUT_SECONDS=30
WORKFLOW_MAX_REPAIRS=1
WORKFLOW_MAX_BYTES=2097152
WORKFLOW_MAX_CHARS=200000
WORKFLOW_MAX_PAGES=50
WORKFLOW_CHUNK_TOKENS=1200
WORKFLOW_MAX_CALLS=512
WORKFLOW_CONTEXT_TOKENS=8192
WORKFLOW_CACHE_ENABLED=false
WORKFLOW_CACHE_DIR=.cache/workflow
WORKFLOW_PRICE_FILE=config/prices.json
